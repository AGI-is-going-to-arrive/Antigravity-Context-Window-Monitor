{
  "command": "node",
  "args": ["main.mjs"],
  "restart_policy": "always",
  "display_name": "Context Monitor",
  "description": "Real-time context window usage, token breakdown, prompt cache diagnostics, and model quota runway monitor.",
  "has_web_ui": true,
  "agent_permissions": {
    "allows_user_interactions": false
  },
  "ui_config": {
    "display_name": "Context Monitor",
    "views": [
      {
        "path": "/",
        "entrypoint": "SIDECAR_UI_ENTRYPOINT_AUX_PANE",
        "title": "Context Monitor"
      },
      {
        "path": "/full",
        "entrypoint": "SIDECAR_UI_ENTRYPOINT_SIDEBAR",
        "title": "Context Monitor"
      }
    ]
  }
}
